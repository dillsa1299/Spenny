# Deploy environment for self-hosted stacks (dev and prod use different values).
# GitHub Actions: paste the full file (no comments required) into Environment secret SPENNY_DOTENV
#   (development vs production each have their own copy of the secret).
# Manual deploy on the server: save as a file and pass --env-file to compose (see docs/deploy/self-hosted.md).

# --- Published client port (nginx serves SPA + proxies /api) ---
SPENNY_CLIENT_HOST_PORT=8080

# --- API (Development shows the in-app banner via GET /api/health; use Production on prod) ---
ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL (internal to Compose; not published in deploy overlay) ---
POSTGRES_USER=spenny
POSTGRES_PASSWORD=change_me_use_strong_secret
POSTGRES_DB=spenny

# --- API (public URL users open in the browser; drives OAuth redirects and email links) ---
Auth__SpaBaseUrl=https://dev.example.com

# Google OAuth (optional)
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=

# Transactional email (optional; API logs verification links when SMTP is unset)
# Email__SmtpHost=
# Email__SmtpPort=587
# Email__SmtpUser=
# Email__SmtpPassword=
# Email__FromAddress=noreply@example.com
# Email__FromName=Spenny
