# Spenny — single local configuration file (frontend + API + Docker Postgres).
# Copy to `.env` in this directory (gitignored):  cp .env.example .env
#
# ASP.NET Core reads keys with double underscores (e.g. Auth__SpaBaseUrl).
# Vite exposes only variables prefixed with VITE_ to the browser.

# --- PostgreSQL (Docker Compose + API on host) ---
POSTGRES_USER=spenny
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=spenny
# Host port mapped to Postgres in Docker (container listens on 5432 internally).
POSTGRES_PORT=5433
# API connection when running on the host (dotnet run / Visual Studio F5).
POSTGRES_HOST=localhost

# Optional override; if unset, the API builds this from POSTGRES_* above.
# ConnectionStrings__Default=Host=localhost;Port=5433;Database=spenny;Username=spenny;Password=change_me_local_only

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
# Must match the URL in your browser (Vite dev server). Google OAuth redirect URI is {SpaBaseUrl}/api/auth/google/callback
Auth__SpaBaseUrl=http://localhost:5173

# Google OAuth (optional; leave blank to hide Google sign-in)
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=

# Transactional email (optional; API logs links to console when SMTP is unset)
# Email__SmtpHost=
# Email__SmtpPort=587
# Email__SmtpUser=
# Email__SmtpPassword=
# Email__FromAddress=noreply@localhost
# Email__FromName=Spenny

# --- Client (Vite) ---
# Leave empty to use the dev-server /api proxy (recommended). Set for direct API calls or production builds.
# VITE_API_BASE_URL=
# Dev proxy target when VITE_API_BASE_URL is unset (not exposed to browser).
SPENNY_API_HTTP_URL=http://127.0.0.1:5050
